#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 ]]; then
    echo "Usage: dn42atlas-request-admin [env-file]" >&2
    exit 2
fi

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
env_file="${1:-${DN42ATLAS_ADMIN_ENV_FILE:-$HOME/.config/dn42atlas/oidc.env}}"
if [[ -f "$env_file" ]]; then
    # This is trusted deployment configuration, sourced as shell code.
    set -a
    source "$env_file"
    set +a
elif [[ $# -eq 1 || -n "${DN42ATLAS_ADMIN_ENV_FILE:-}" ]]; then
    echo "Environment file not found." >&2
    exit 1
fi

cd -- "$repo_dir"
command -v dotnet >/dev/null 2>&1 || { echo "dotnet is required." >&2; exit 1; }

run_cli()
{
    dotnet run --project "$repo_dir/DN42Atlas.OptOut" --no-launch-profile -- "$@"
}

read_id()
{
    read -rp "Request ID: " id || return 1
    if [[ ! "$id" =~ ^[0-9]+$ || ! "$id" =~ [1-9] ]]; then
        echo "Invalid ID."
        return 1
    fi
}

show_request()
{
    if read_id; then
        run_cli manual-request "$id" || echo "Unable to show request." >&2
    fi
}

change_status()
{
    local id choice status
    read_id || return 0
    run_cli manual-request "$id" || return 0
    echo "New status:"
    echo "1) Pending"
    echo "2) Reviewed"
    echo "3) Resolved"
    echo "4) Rejected"
    read -rp "Choice: " choice || return 0
    case "$choice" in
        1) status=Pending ;;
        2) status=Reviewed ;;
        3) status=Resolved ;;
        4) status=Rejected ;;
        *) echo "Cancelled."; return 0 ;;
    esac
    run_cli manual-request-status "$id" "$status" || echo "Unable to change status." >&2
}

delete_request()
{
    local id confirmation
    read_id || return 0
    run_cli manual-request "$id" || return 0
    echo "This permanently deletes request $id."
    read -rp "Type DELETE to continue: " confirmation || return 0
    if [[ "$confirmation" != "DELETE" ]]; then
        echo "Cancelled."
        return 0
    fi
    run_cli manual-request-delete "$id" || echo "Unable to delete request." >&2
}

while true; do
    echo
    echo "DN42Atlas Manual Request Admin"
    echo "=============================="
    echo "1) Show pending requests"
    echo "2) Show full request"
    echo "3) Change status"
    echo "4) Delete request"
    echo "5) Quit"
    read -rp "Choice: " choice || exit 0
    case "$choice" in
        1) run_cli manual-requests || echo "Unable to list requests." >&2 ;;
        2) show_request ;;
        3) change_status ;;
        4) delete_request ;;
        5|q|Q) exit 0 ;;
        *) echo "Unknown choice." ;;
    esac
done
