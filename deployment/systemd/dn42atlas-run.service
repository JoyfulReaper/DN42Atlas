[Unit]
Description=DN42Atlas daily crawl and hidden artifact publication
Wants=network-online.target
After=network-online.target dn42atlas-registry-update.service

[Service]
Type=oneshot
User=joyfulreaper
Group=joyfulreaper
WorkingDirectory=/opt/DN42Atlas
Environment=HOME=/home/joyfulreaper
EnvironmentFile=/home/joyfulreaper/.config/dn42atlas/crawler.env
ExecStart=/usr/bin/dotnet run --project /opt/DN42Atlas/DN42Atlas/DN42Atlas.csproj -c Release --no-launch-profile -- run
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
